# build output (regenerated each run / deployed to Pages)
public/

# Savant CSV leaderboard cache (restored from actions/cache in CI)
.savant_cache/
savant_cache_*.csv
.walkforward_cache/

# team cap-logo cache (inlined into the page at build; re-fetchable, not tracked)
logo_cap_*.svg

# python
__pycache__/
*.pyc
.venv/
venv/

# atomic-write temp files (_atomic_csv writes data/.<name>.<rand>.tmp then
# os.replace()s it into place). A process killed mid-write leaves one behind,
# and the ledger commit's `git add data/` would stage a partial CSV -- past the
# validate_data_files.py run that precedes it.
*.tmp
